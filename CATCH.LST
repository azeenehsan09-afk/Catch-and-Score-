     1                                  ; ============================================================
     2                                  ; COAL Project - CATCH & SCORE   (Phase I)
     3                                  
     4                                  ; Theme   : Coins / Apples / Stars  -> Basket -> Bombs / Crosses
     5                                  ; Phase I : start screen, game screen (3x3 objects, timer,
     6                                  ;           live score) and end screen.
     7                                  ;
     8                                  
     9                                  [org 0x0100]
    10 00000000 E9A805                   jmp start
    11                                  
    12                                  ; ------------------------------------------------------------
    13                                  ; Variables
    14                                  ; ------------------------------------------------------------
    15 00000003 0000                    score:      dw 0            ; live score (0..9999)
    16 00000005 1E00                    timeleft:   dw 30           ; remaining game time in seconds
    17 00000007 0A00                    tickdelay:  dw 10           ; outer delay count for ~1 second
    18                                                              ; (tune: bigger = slower clock)
    19                                  
    20                                  ; ------------------------------------------------------------
    21                                  ; 3x3 sprites: 9 words each. High byte = attribute, low byte =
    22                                  ; ASCII / CP437 code.  0x0000 = transparent.
    23                                  ; ------------------------------------------------------------
    24 00000009 0000DC0E0000            coin:   dw 0x0000, 0x0EDC, 0x0000      ;   ▄
    25 0000000F DE0E240EDD0E                    dw 0x0EDE, 0x0E24, 0x0EDD      ;  ▐$▌
    26 00000015 0000DF0E0000                    dw 0x0000, 0x0EDF, 0x0000      ;   ▀
    27                                  
    28 0000001B 00002F0A0000            apple:  dw 0x0000, 0x0A2F, 0x0000      ;   /   (green leaf)
    29 00000021 DE0CDB0CDD0C                    dw 0x0CDE, 0x0CDB, 0x0CDD      ;  ▐█▌  (red body)
    30 00000027 0000DF0C0000                    dw 0x0000, 0x0CDF, 0x0000      ;   ▀
    31                                  
    32 0000002D 00007C0B0000            star:   dw 0x0000, 0x0B7C, 0x0000      ;   |
