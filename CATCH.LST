   152                                  
   153                                  ; ------------------------------------------------------------
   154                                  ; fillrect - fills a rectangle of screen cells with one cell
   155                                  ; Parameters (pushed in this order): top, left, height, width,
   156                                  ;   cell (high byte attribute, low byte character).
   157                                  ; height and width must be at least 1.
   158                                  ; ------------------------------------------------------------
   159 000002C7 55                      fillrect:   push bp
   160 000002C8 89E5                                mov bp, sp                  ; [bp+12]=top  [bp+10]=left
   161 000002CA 50                                  push ax                     ; [bp+8]=height [bp+6]=width
   162 000002CB 53                                  push bx                     ; [bp+4]=cell
   163 000002CC 51                                  push cx
   164 000002CD 52                                  push dx
   165 000002CE 57                                  push di
   166 000002CF 06                                  push es
   167 000002D0 B800B8                              mov ax, 0xb800
   168 000002D3 8EC0                                mov es, ax                  ; es -> video memory
   169 000002D5 B050                                mov al, 80                  ; columns per row
   170 000002D7 F6660C                              mul byte [bp+12]            ; ax = top * 80
   171 000002DA 03460A                              add ax, [bp+10]             ; + left
   172 000002DD D1E0                                shl ax, 1                   ; two bytes per cell
   173 000002DF 89C7                                mov di, ax                  ; di = offset of first cell
   174 000002E1 8B5608                              mov dx, [bp+8]              ; rows left to fill
   175 000002E4 8B4604                              mov ax, [bp+4]              ; ax = cell to write
   176 000002E7 8B4E06                  fr_row:     mov cx, [bp+6]              ; columns in this row
   177 000002EA 89FB                                mov bx, di                  ; bx = start of this row
   178 000002EC 268907                  fr_col:     mov [es:bx], ax             ; write one cell
   179 000002EF 81C30200                            add bx, 2                   ; next cell
   180 000002F3 49                                  dec cx
   181 000002F4 75F6                                jnz fr_col
   182 000002F6 81C7A000                            add di, 160                 ; next screen row
   183 000002FA 4A                                  dec dx
   184 000002FB 75EA                                jnz fr_row
   185 000002FD 07                                  pop es
   186 000002FE 5F                                  pop di
   187 000002FF 5A                                  pop dx
   188 00000300 59                                  pop cx
   189 00000301 5B                                  pop bx
   190 00000302 58                                  pop ax
   191 00000303 89EC                                mov sp, bp
   192 00000305 5D                                  pop bp
   193 00000306 C20A00                              ret 10
   194                                  
   195                                  ; ------------------------------------------------------------
   196                                  ; clrscr - clears the whole screen (no parameters)
   197                                  ; ------------------------------------------------------------
   198 00000309 55                      clrscr:     push bp
   199 0000030A 89E5                                mov bp, sp
   200 0000030C 50                                  push ax
   201 0000030D B80000                              mov ax, 0
   202 00000310 50                                  push ax                     ; top = 0
   203 00000311 50                                  push ax                     ; left = 0
   204 00000312 B81900                              mov ax, 25
   205 00000315 50                                  push ax                     ; height = 25
   206 00000316 B85000                              mov ax, 80
   207 00000319 50                                  push ax                     ; width = 80
   208 0000031A B82007                              mov ax, 0x0720              ; space, grey on black
   209 0000031D 50                                  push ax
   210 0000031E E8A6FF                              call fillrect
   211 00000321 58                                  pop ax
   212 00000322 89EC                                mov sp, bp
   213 00000324 5D                                  pop bp
   214 00000325 C3                                  ret
