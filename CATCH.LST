    37 00000045 DB07DB07DB07                    dw 0x07DB, 0x07DB, 0x07DB      ;  ███  (grey body)
    38 0000004B 0000DF070000                    dw 0x0000, 0x07DF, 0x0000      ;   ▀
    39                                  
    40 00000051 5C0C00002F0C            cross:  dw 0x0C5C, 0x0000, 0x0C2F      ;  \ /
    41 00000057 0000580C0000                    dw 0x0000, 0x0C58, 0x0000      ;   X
    42 0000005D 2F0C00005C0C                    dw 0x0C2F, 0x0000, 0x0C5C      ;  / 
    43 00000063 5C0F00002F0F            basket: dw 0x0F5C, 0x0000, 0x0F2F      ;  \ /
    44 00000069 DB06DB06DB06                    dw 0x06DB, 0x06DB, 0x06DB      ;  ███  (brown)
    45 0000006F 0000DF060000                    dw 0x0000, 0x06DF, 0x0000      ;   ▀
