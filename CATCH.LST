   412                                  ; drawobj - draws a 3x3 object (9 words, row by row)
   413                                  ; Parameters: row, column (top-left cell), address of sprite
   414                                  ; ------------------------------------------------------------
   415 00000488 55                      drawobj:    push bp
   416 00000489 89E5                                mov bp, sp                  ; [bp+8]=row [bp+6]=col
   417 0000048B 50                                  push ax                     ; [bp+4]=sprite
   418 0000048C 53                                  push bx
   419 0000048D 51                                  push cx
   420 0000048E 52                                  push dx
   421 0000048F 56                                  push si
   422 00000490 57                                  push di
   423 00000491 06                                  push es
   424 00000492 B800B8                              mov ax, 0xb800
   425 00000495 8EC0                                mov es, ax
   426 00000497 B050                                mov al, 80
   427 00000499 F66608                              mul byte [bp+8]             ; ax = row * 80
   428 0000049C 034606                              add ax, [bp+6]
   429 0000049F D1E0                                shl ax, 1
   430 000004A1 89C7                                mov di, ax                  ; di = offset of top-left
   431 000004A3 8B7604                              mov si, [bp+4]              ; si = sprite data
   432 000004A6 BA0300                              mov dx, 3                   ; 3 object rows
   433 000004A9 B90300                  do_row:     mov cx, 3                   ; 3 object columns
   434 000004AC 89FB                                mov bx, di
   435 000004AE 8B04                    do_col:     mov ax, [si]                ; next cell of sprite
