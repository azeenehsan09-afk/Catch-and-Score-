   318                                  ; ------------------------------------------------------------
   319                                  ; printstr - prints a null terminated string
   320                                  ; Parameters: row, column, attribute, address of string
   321                                  ; ------------------------------------------------------------
   322 000003D5 55                      printstr:   push bp
   323 000003D6 89E5                                mov bp, sp                  ; [bp+10]=row [bp+8]=col
   324 000003D8 50                                  push ax                     ; [bp+6]=attr [bp+4]=string
   325 000003D9 52                                  push dx
   326 000003DA 56                                  push si
   327 000003DB 57                                  push di
   328 000003DC 06                                  push es
   329 000003DD B800B8                              mov ax, 0xb800
   330 000003E0 8EC0                                mov es, ax
   331 000003E2 B050                                mov al, 80
   332 000003E4 F6660A                              mul byte [bp+10]            ; ax = row * 80
   333 000003E7 034608                              add ax, [bp+8]              ; + column
   334 000003EA D1E0                                shl ax, 1
   335 000003EC 89C7                                mov di, ax                  ; di = screen offset
   336 000003EE 8B7604                              mov si, [bp+4]              ; si = string
   337 000003F1 8A7606                              mov dh, [bp+6]              ; dh = attribute
   338 000003F4 8A14                    ps_next:    mov dl, [si]                ; next character
   339 000003F6 80FA00                              cmp dl, 0
   340 000003F9 740D                                je ps_done                  ; zero ends the string
   341 000003FB 268915                              mov [es:di], dx             ; attribute:character
   342 000003FE 81C70200                            add di, 2
   343 00000402 81C60100                            add si, 1
   344 00000406 EBEC                                jmp ps_next
   345 00000408 07                      ps_done:    pop es
   346 00000409 5F                                  pop di
   347 0000040A 5E                                  pop si
   348 0000040B 5A                                  pop dx
   349 0000040C 58                                  pop ax
   350 0000040D 89EC                                mov sp, bp
   351 0000040F 5D                                  pop bp
   352 00000410 C20800                              ret 8
   353                                  
   354                                  ; ------------------------------------------------------------
   355                                  ; printnum - prints an unsigned decimal number (no DIV needed:
   356                                  ; digits are found by repeated subtraction of 1000/100/10/1)
   357                                  ; Parameters: row, column, attribute, value, number of digits
   358                                  ;             (1 to 4)
   359                                  ; Local array: [bp-2]=1  [bp-4]=10  [bp-6]=100  [bp-8]=1000
   360                                  ; ------------------------------------------------------------
   361 00000413 55                      printnum:   push bp
   362 00000414 89E5                                mov bp, sp                  ; [bp+12]=row [bp+10]=col
   363 00000416 81EC0800                            sub sp, 8                   ; [bp+8]=attr [bp+6]=value
   364 0000041A 50                                  push ax                     ; [bp+4]=digits
   365 0000041B 53                                  push bx
   366 0000041C 52                                  push dx
   367 0000041D 56                                  push si
   368 0000041E 57                                  push di
   369 0000041F 06                                  push es
   370 00000420 C746FE0100                          mov word [bp-2], 1
   371 00000425 C746FC0A00                          mov word [bp-4], 10
   372 0000042A C746FA6400                          mov word [bp-6], 100
   373 0000042F C746F8E803                          mov word [bp-8], 1000
   374 00000434 B800B8                              mov ax, 0xb800
   375 00000437 8EC0                                mov es, ax
   376 00000439 B050                                mov al, 80
   377 0000043B F6660C                              mul byte [bp+12]            ; ax = row * 80
   378 0000043E 03460A                              add ax, [bp+10]
   379 00000441 D1E0                                shl ax, 1
   380 00000443 89C7                                mov di, ax                  ; di = screen offset
   381 00000445 8B7604                              mov si, [bp+4]              ; si = number of digits
   382 00000448 D1E6                                shl si, 1                   ; bytes in local array
   383 0000044A B80000                              mov ax, 0
   384 0000044D 29F0                                sub ax, si
   385 0000044F 89C6                                mov si, ax                  ; si = -2 * digits
   386 00000451 8B4606                              mov ax, [bp+6]              ; ax = value
   387 00000454 8B1A                    pn_digit:   mov bx, [bp+si]             ; bx = current divisor
   388 00000456 BA0000                              mov dx, 0                   ; dx = digit counter
   389 00000459 39D8                    pn_count:   cmp ax, bx
   390 0000045B 7208                                jb pn_got                   ; remainder < divisor
   391 0000045D 29D8                                sub ax, bx
   392 0000045F 81C20100                            add dx, 1
   393 00000463 EBF4                                jmp pn_count
   394 00000465 80C230                  pn_got:     add dl, 0x30                ; digit -> ASCII
   395 00000468 8A7608                              mov dh, [bp+8]              ; attribute
   396 0000046B 268915                              mov [es:di], dx
   397 0000046E 81C70200                            add di, 2
   398 00000472 81C60200                            add si, 2                   ; next smaller divisor
   399 00000476 81FE0000                            cmp si, 0
   400 0000047A 75D8                                jne pn_digit
   401 0000047C 07                                  pop es
   402 0000047D 5F                                  pop di
   403 0000047E 5E                                  pop si
   404 0000047F 5A                                  pop dx
   405 00000480 5B                                  pop bx
   406 00000481 58                                  pop ax
   407 00000482 89EC                                mov sp, bp
   408 00000484 5D                                  pop bp
   409 00000485 C20A00                              ret 10
