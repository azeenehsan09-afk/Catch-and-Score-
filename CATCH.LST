   474 000004E8 8EC0                                mov es, ax
   475 000004EA B050                                mov al, 80
   476 000004EC F6660A                              mul byte [bp+10]            ; ax = row * 80
   477 000004EF 034608                              add ax, [bp+8]              ; + column
   478 000004F2 D1E0                                shl ax, 1
   479 000004F4 89C7                                mov di, ax                  ; di = start of letter row
   480 000004F6 8B7604                              mov si, [bp+4]              ; si = shape bytes
   481 000004F9 8A7606                              mov dh, [bp+6]              ; dh = colour
   482 000004FC B2DB                                mov dl, 0xDB                ; dl = full block
   483 000004FE C746FE0500                          mov word [bp-2], 5          ; 5 pixel rows
   484 00000503 8A04                    dlt_row:    mov al, [si]                ; al = pixels of this row
   485 00000505 89FB                                mov bx, di                  ; bx = screen pointer
   486 00000507 B90500                              mov cx, 5                   ; 5 pixels per row
   487 0000050A A810                    dlt_pix:    test al, 0x10               ; is the left pixel set?
   488 0000050C 7407                                jz dlt_skip
   489 0000050E 268917                              mov [es:bx], dx             ; pixel = two block cells
   490 00000511 26895702                            mov [es:bx+2], dx
   491 00000515 81C30400                dlt_skip:   add bx, 4                   ; next pixel (2 cells)
   492 00000519 D0E0                                shl al, 1                   ; bring next pixel to bit 4
   493 0000051B 49                                  dec cx
