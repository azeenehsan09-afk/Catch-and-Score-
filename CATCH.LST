    47                                  ; ------------------------------------------------------------
    48                                  ; Big title font: 5x5 pixels per letter, 5 bytes per letter
    49                                  ; (one byte per pixel row, bits 4..0 = pixels left to right).
    50                                  ; Letter numbers: 0=C 1=A 2=T 3=H 4=S 5=O 6=R 7=E
    51                                  ; ------------------------------------------------------------
    52 00000075 0F1010100F              font:   db 0x0F, 0x10, 0x10, 0x10, 0x0F    ; 0 = C
    53 0000007A 0E111F1111                      db 0x0E, 0x11, 0x1F, 0x11, 0x11    ; 1 = A
    54 0000007F 1F04040404                      db 0x1F, 0x04, 0x04, 0x04, 0x04    ; 2 = T
    55 00000084 11111F1111                      db 0x11, 0x11, 0x1F, 0x11, 0x11    ; 3 = H
    56 00000089 0F100E011E                      db 0x0F, 0x10, 0x0E, 0x01, 0x1E    ; 4 = S
    57 0000008E 0E1111110E                      db 0x0E, 0x11, 0x11, 0x11, 0x0E    ; 5 = O
    58 00000093 1E111E1211                      db 0x1E, 0x11, 0x1E, 0x12, 0x11    ; 6 = R
    59 00000098 1F101E101F                      db 0x1F, 0x10, 0x1E, 0x10, 0x1F    ; 7 = E
    60 0000009D 0001020003FF            w_catch: db 0, 1, 2, 0, 3, 0xFF            ; C A T C H  (0xFF = end)
    61 000000A3 0400050607FF            w_score: db 4, 0, 5, 6, 7, 0xFF            ; S C O R E
